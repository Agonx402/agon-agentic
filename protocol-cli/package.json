{
  "name": "@ryvonetwork/protocol-cli",
  "version": "0.4.2",
  "description": "Read-only and prepare-only CLI for Ryvo Protocol agents.",
  "license": "MIT",
  "homepage": "https://github.com/Ryvonetwork/ryvo-agentic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryvonetwork/ryvo-agentic.git",
    "directory": "protocol-cli"
